# Copy to .env and fill in. .env is git-ignored.
#
# Both of these are safe to expose in the browser bundle — the publishable key
# is designed for client-side use and is gated by Row Level Security.
#
# NEVER put a service_role key or an `sb_secret_...` key in this file or any
# other file under app/. Vite inlines every VITE_-prefixed variable into the
# built JavaScript, so a secret key here becomes a public secret key.

VITE_SUPABASE_URL=https://tpjugbazpmcepiaqvjtx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
